# Database
DATABASE_URL=postgresql://viewnoveen:viewnoveen@localhost:5432/viewnoveen
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=7d
REFRESH_TOKEN_EXPIRATION=30d

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# Apple Sign In
APPLE_CLIENT_ID=com.viewnoveen.app
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id
APPLE_PRIVATE_KEY=your-apple-private-key

# AWS S3 / Cloudflare R2
STORAGE_PROVIDER=s3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=viewnoveen-uploads
CLOUDFLARE_R2_ENDPOINT=https://your-account.r2.cloudflarestorage.com

# Video Processing
FFMPEG_PATH=/usr/bin/ffmpeg
MAX_FILE_SIZE=2147483648
HLS_SEGMENT_DURATION=6
HLS_LIST_SIZE=0

# WebRTC
STUN_SERVER=stun.l.google.com:19302
TURN_SERVER=turn.your-server.com:3478
TURN_USERNAME=viewnoveen
TURN_CREDENTIAL=your-turn-credential

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Socket.IO
SOCKET_PATH=/ws
SOCKET_CORS_ORIGIN=http://localhost:3000

# Services
API_GATEWAY_PORT=4000
AUTH_SERVICE_PORT=4001
USERS_SERVICE_PORT=4002
ROOMS_SERVICE_PORT=4003
CHAT_SERVICE_PORT=4004
VIDEO_SERVICE_PORT=4005
STREAMING_SERVICE_PORT=4006
SYNC_SERVICE_PORT=4007
WEBRTC_SERVICE_PORT=4008
SOCIAL_SERVICE_PORT=4009
MUSIC_SERVICE_PORT=4010
AI_SERVICE_PORT=4011
NOTIFICATION_SERVICE_PORT=4012
UPLOAD_SERVICE_PORT=4013

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id

# Admin
ADMIN_API_KEY=your-admin-api-key

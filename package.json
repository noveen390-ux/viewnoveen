{
  "name": "viewnoveen",
  "version": "1.0.0",
  "private": true,
  "description": "World-class social watch-party platform",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "turbo start",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:generate": "cd packages/database && npx prisma generate",
    "db:push": "cd packages/database && npx prisma db push",
    "db:migrate": "cd packages/database && npx prisma migrate dev",
    "db:seed": "cd packages/database && npx prisma db seed",
    "services:all": "turbo run dev --parallel --no-cache",
    "test": "node _final-test.js",
    "test:regression": "node regression-test.js",
    "test:all": "node regression-test.js && node _final-test.js",
    "lint:check": "npx eslint --no-eslintrc -c .eslintrc.json --ext .js --ignore-pattern node_modules --ignore-pattern apps --ignore-pattern packages .",
    "lint:fix": "npx eslint --no-eslintrc -c .eslintrc.json --ext .js --ignore-pattern node_modules --ignore-pattern apps --ignore-pattern packages --fix .",
    "dev:server": "node server.js",
    "dev:watch": "npx nodemon --watch . --ext js,html,json --ignore node_modules --ignore apps --ignore packages server.js"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.0",
    "socket.io-client": "^4.8.3",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "express": "^5.2.1",
    "puppeteer": "^25.1.0",
    "socket.io": "^4.8.3"
  },
  "main": "server.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noveen390-ux/viewnoveen.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/noveen390-ux/viewnoveen/issues"
  },
  "homepage": "https://github.com/noveen390-ux/viewnoveen#readme"
}
